# EditorConfig is awesome: https://EditorConfig.org

# 表明这是最顶层的配置文件
root = true

# 对所有文件生效
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
tab_width = 2
trim_trailing_whitespace = true
insert_final_newline = true

# 对 Markdown 文件的特殊处理
[*.md]
trim_trailing_whitespace = false